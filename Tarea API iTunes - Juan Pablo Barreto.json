  "item": [
    {
      "name": "Trae lista de canciones de Nsqk",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Validar que el request fue exitoso\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Test 2: Validar que la respuesta contiene el contador de resultados\r",
              "pm.test(\"Contiene la propiedad resultCount\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('resultCount');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://itunes.apple.com/search?term=Nsqk&media=music",
          "protocol": "https",
          "host": [
            "itunes",
            "apple",
            "com"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "term",
              "value": "Nsqk"
            },
            {
              "key": "media",
              "value": "music"
            }
          ]
        }
      },
      "response": []
    },
